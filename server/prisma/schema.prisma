// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// Add ENUM for role
enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OTP_Types {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum Feature {
  CATEGORY
  PRODUCT
}

model User {
  id                   Int                  @id @default(autoincrement())
  name                 String
  email                String               @unique
  password             String
  mobile               String?
  role                 Role                 @default(USER)
  status               Status               @default(ACTIVE)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orders               Order[]
  orderStatusHistories OrderStatusHistory[]
}

model Category {
  id        Int       @id @default(autoincrement())
  title     String    @unique
  slug      String    @unique
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model File {
  id        Int      @id @default(autoincrement())
  feature   Feature?
  featureId Int?
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hsn {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  tax       Int
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id            Int             @id @default(autoincrement())
  variant       String?
  title         String          @unique
  slug          String          @unique
  category      Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId    Int
  mrp           Float
  price         Float
  Hsn           Hsn?            @relation(fields: [hsnId], references: [id], onDelete: Restrict)
  hsnId         Int?
  Size          Size?           @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  sizeId        Int?
  Color         Color?          @relation(fields: [colorId], references: [id], onDelete: Restrict)
  colorId       Int?
  status        Status          @default(ACTIVE)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  orderProducts OrderProducts[]
  stocks        Stock[]
}

model Size {
  id        Int       @id @default(autoincrement())
  title     String    @unique
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Color {
  id        Int       @id @default(autoincrement())
  title     String    @unique
  code      String    @unique
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Otp {
  id         Int       @id @default(autoincrement())
  type       OTP_Types
  email      String
  otp        String
  meta       Json?
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

enum OrderStatus {
  PAYMENT_PENDING
  PAYMENT_FAILED
  PLACED
  CONFIRMED
  REJECTED
  SHIPPED
  CANCELLED
  DELIVERED
}

enum PaymentType {
  ONLINE
  COD
}

model Order {
  id                   Int                  @id @default(autoincrement())
  user                 User                 @relation(fields: [userId], references: [id])
  userId               Int
  orderNo              String               @unique
  name                 String
  mobile               String
  address              String
  city                 String
  pincode              String
  country              String
  state                String
  isDiffBillAdd        Boolean
  status               OrderStatus
  paymentType          PaymentType
  paymentOrderId       String?              @unique
  billingInfo          Json?
  notes                String?
  discount             Int                  @default(0)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  orderProducts        OrderProducts[]
  orderStatusHistories OrderStatusHistory[]
}

model OrderProducts {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Int
  mrp       Int
  tax       Int      @default(0)
  stock     Stock    @relation(fields: [stockId], references: [id])
  stockId   Int      @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum StockType {
  PRODUCT
  ORDER
  PAYMENT_PENDING
  WITHDRAW
}

model Stock {
  id            Int            @id @default(autoincrement())
  type          StockType
  product       Product        @relation(fields: [productId], references: [id])
  productId     Int
  quantity      Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderProducts OrderProducts?
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  user      User        @relation(fields: [userId], references: [id])
  userId    Int
  meta      Json?
  status    OrderStatus
  createdAt DateTime    @default(now())

  @@unique([orderId, status])
}

model Config {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
