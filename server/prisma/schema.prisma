// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../prisma/generated"
}

datasource db {
  provider = "postgresql"
}

// Add ENUM for role
enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
}

enum OTP_Types {
  LOGIN
  REGISTER
  RESET_PASSWORD
}

enum Feature {
  CATEGORY
  PRODUCT
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  mobile    String?
  role      Role     @default(USER)
  status    Status   @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  title     String    @unique
  slug      String    @unique
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model File {
  id        Int      @id @default(autoincrement())
  feature   Feature?
  featureId Int?
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Hsn {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  tax       Int
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id         Int      @id @default(autoincrement())
  title      String   @unique
  slug       String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  categoryId Int
  mrp        Float
  price      Float
  Hsn        Hsn?     @relation(fields: [hsnId], references: [id], onDelete: Restrict)
  hsnId      Int?
  Size       Size?    @relation(fields: [sizeId], references: [id], onDelete: Restrict)
  sizeId     Int?
  Color      Color?   @relation(fields: [colorId], references: [id], onDelete: Restrict)
  colorId    Int?
  stock      Int
  status     Status   @default(ACTIVE)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Size {
  id        Int       @id @default(autoincrement())
  title     String    @unique
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Color {
  id        Int       @id @default(autoincrement())
  title     String    @unique
  code      String    @unique
  status    Status    @default(ACTIVE)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Otp {
  id        Int       @id @default(autoincrement())
  type      OTP_Types
  email     String
  otp       String    @unique
  meta      Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
